# ---------- Server ----------
PORT=4000
NODE_ENV=development
# Set to true when running behind a reverse proxy / load balancer (Hostinger, Render, Nginx)
TRUST_PROXY=false

# ---------- App sign-in ----------
# Random string, at least 32 characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_HOURS=12
# Users: username:role:bcryptHash  (role = admin | viewer), separate users with ";"
# Generate an entry with:  npm run hash-password -- <username> <admin|viewer> <password>
APP_USERS=

# ---------- Google Sheet (source of truth, read-only) ----------
# The ID from the sheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SPREADSHEET_ID=
# Optional: which worksheet tab opens by default (defaults to the first tab with data)
GOOGLE_PRIMARY_TAB=

# auto | service_account | api_key | public_csv
#  auto            -> service_account if a key is configured, else api_key, else public_csv
#  service_account -> RECOMMENDED. Share the sheet (Viewer) with the service-account email.
#  api_key         -> Sheets API with an API key; only works while the sheet is link-shared.
#  public_csv      -> no credentials; only works while "Anyone with the link can view" is on.
GOOGLE_AUTH_MODE=auto
# Path to the service-account JSON key (keep it OUTSIDE the web root, never commit it)
GOOGLE_SERVICE_ACCOUNT_FILE=
# ...or paste the whole JSON key on one line (handy on hosting dashboards)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_API_KEY=

# How long (seconds) to cache sheet data before re-reading Google
CACHE_TTL_SECONDS=300
# Used for WhatsApp links from 10-digit phone numbers
DEFAULT_PHONE_COUNTRY_CODE=91
