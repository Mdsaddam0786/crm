# ---------- Server ----------
PORT=4000
NODE_ENV=development
# Set to true when running behind a reverse proxy / load balancer (Hostinger, Render, Nginx)
TRUST_PROXY=false

# ---------- App sign-in ----------
# Random string, at least 32 characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_HOURS=12
# Users: username:role:bcryptHash  (role = admin | editor | viewer), separate users with ";"
# Generate an entry with:  npm run hash-password -- <username> <admin|editor|viewer> <password>
APP_USERS=

# ---------- Database ----------
# MongoDB connection string. REQUIRED on Vercel (serverless has no persistent disk).
# Free cluster: https://www.mongodb.com/atlas  (or add MongoDB Atlas from the Vercel Marketplace)
# Leave empty locally to store data in data/listings.json
MONGODB_URI=
MONGODB_DB=jv_crm
# Optional: folder for the local JSON data file (default ./data)
DATA_DIR=

# Used for WhatsApp links from 10-digit phone numbers
DEFAULT_PHONE_COUNTRY_CODE=91
